{
  "name": "remix-discord-bot",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24.3.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "NODE_ENV=development node --env-file-if-exists=.env --watch --import remix/node-tsx server.ts",
    "start": "NODE_ENV=production node --env-file-if-exists=.env --import remix/node-tsx server.ts",
    "test": "NODE_ENV=test remix test",
    "test:coverage": "NODE_ENV=test remix test --coverage",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm test",
    "deploy:commands": "node --env-file-if-exists=.env --import remix/node-tsx scripts/deploy-commands.ts",
    "deploy:emojis": "node --env-file-if-exists=.env --import remix/node-tsx scripts/deploy-emojis.ts"
  },
  "dependencies": {
    "discord.js": "14.27.0",
    "remix": "3.0.0-rc.2"
  },
  "devDependencies": {
    "@types/node": "24.13.4",
    "playwright": "1.60.0",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
